# Groq API key(s) for the live sampler (server-side only — never exposed to the browser).
# Get keys at https://console.groq.com/keys
# Set this in Vercel: Project → Settings → Environment Variables.
#
# You may supply MULTIPLE keys, comma-separated. The sampler round-robins the
# per-type calls across them (each key has its own ~12K TPM budget), so the 5
# parallel calls don't overshoot a single key's rate limit.
GROQ_API_KEY=gsk_key_one,gsk_key_two,gsk_key_three

# Optional: override the default model (llama-3.3-70b-versatile).
# Alternatives tested: llama-4-scout (30K TPM but under-delivers exact counts),
# gpt-oss/compound (reasoning/agentic — truncate or emit non-JSON).
# GROQ_MODEL=llama-3.3-70b-versatile
